# Optional: absolute path to yt-dlp if it is not available on PATH.
YT_DLP_PATH=yt-dlp

# Optional: absolute path to ffmpeg if it is not available on PATH.
FFMPEG_LOCATION=

# Optional: max concurrent downloads per server process (default 3).
MAX_CONCURRENT_DOWNLOADS=3

# Set true only when running behind a proxy that overwrites x-forwarded-for.
TRUST_PROXY=false
